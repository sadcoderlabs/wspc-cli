{
  "name": "@wspc/cli",
  "version": "0.1.14",
  "description": "Official TypeScript SDK and CLI for wspc (https://wspc.ai)",
  "type": "module",
  "bin": {
    "wspc": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "spec/openapi.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadcoderlabs/wspc-cli.git"
  },
  "scripts": {
    "prepare": "tsx scripts/build-version.ts",
    "sync-spec": "tsx scripts/sync-spec.ts",
    "generate": "npm run generate:sdk && npm run generate:cli",
    "generate:sdk": "openapi-ts",
    "generate:cli": "tsx tools/cli-codegen/main.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run sync-spec && npm run build"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "chrono-node": "2.9.1",
    "commander": "14.0.3",
    "luxon": "3.7.2",
    "node-diff3": "^3.2.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@types/luxon": "3.7.1",
    "@types/node": "25.6.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
